@model EcommerceApp.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-dark text-white">
        <h3>@Model.Name</h3>
    </div>
    <div class="card-body">
        <h5 class="text-muted">Category: @Model.Category.Name</h5>
        <p><strong>SKU:</strong> @Model.SKU</p>
        <h4 class="text-success">$@Model.Price.ToString("0.00")</h4>
        <p>Stock Available: @Model.StockQuantity</p>
        
        <hr />
        @if (Model.StockQuantity > 0)
        {
            <a asp-controller="Cart" asp-action="Add" asp-route-productId="@Model.ProductId" class="btn btn-primary btn-lg">Add to Cart</a>
        }
        else
        {
            <button class="btn btn-danger btn-lg" disabled>Out of Stock</button>
        }
        <a asp-action="Index" class="btn btn-outline-secondary btn-lg ms-2">Back to Catalog</a>
    </div>
</div>