@model IEnumerable<EcommerceApp.ViewModels.CartItemVM>

@{
    ViewData["Title"] = "Shopping Cart";
}

<h2>Your Cart</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Your cart is currently empty.</div>
    <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">Continue Shopping</a>
}
else
{
    <table class="table table-bordered table-striped mt-3">
        <thead class="table-dark">
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Line Total</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>$@item.Price.ToString("0.00")</td>
                    <td>
                        <form asp-action="Update" method="post" class="d-flex align-items-center">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="number" name="quantity" value="@item.Quantity" class="form-control form-control-sm me-2" style="width: 80px;" min="1" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
                        </form>
                    </td>
                    <td class="fw-bold">$@item.LineTotal.ToString("0.00")</td>
                    <td>
                        <a asp-action="Remove" asp-route-productId="@item.ProductId" class="btn btn-sm btn-danger">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end fw-bold">Total:</td>
                <td class="fw-bold text-success">$@Model.Sum(x => x.LineTotal).ToString("0.00")</td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    <div class="d-flex justify-content-between mt-4">
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary">Continue Shopping</a>
        <a asp-controller="Orders" asp-action="Checkout" class="btn btn-success btn-lg">Proceed to Checkout</a>
    </div>
}