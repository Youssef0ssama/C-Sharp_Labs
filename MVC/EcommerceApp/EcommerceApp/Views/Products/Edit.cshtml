@model EcommerceApp.Models.Product
@{
    ViewData["Title"] = "Edit Product";
}

<h2>Edit Product</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="ProductId" />
            <div class="form-group mb-2"><label asp-for="Name"></label><input asp-for="Name" class="form-control" /></div>
            <div class="form-group mb-2"><label asp-for="SKU"></label><input asp-for="SKU" class="form-control" /></div>
            <div class="form-group mb-2">
                <label asp-for="CategoryId">Category</label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
            </div>
            <div class="form-group mb-2"><label asp-for="Price"></label><input asp-for="Price" class="form-control" /></div>
            <div class="form-group mb-2"><label asp-for="StockQuantity"></label><input asp-for="StockQuantity" class="form-control" /></div>
            <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
            
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}