@model IEnumerable<EcommerceApp.Models.Product>
@{
    ViewData["Title"] = "Manage Products";
}

<h2>Manage Products</h2>
<p><a asp-action="Create" class="btn btn-primary">Create New Product</a></p>

<table class="table table-hover">
    <thead>
        <tr><th>Name</th><th>SKU</th><th>Category</th><th>Price</th><th>Stock</th><th>Active</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.SKU</td>
                <td>@item.Category.Name</td>
                <td>$@item.Price</td>
                <td>@item.StockQuantity</td>
                <td>@(item.IsActive ? "Yes" : "No")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-warning">Edit</a>
                    <form asp-action="Delete" asp-route-id="@item.ProductId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>