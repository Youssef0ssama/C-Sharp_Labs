@model IEnumerable<EcommerceApp.Models.Order>
@{
    ViewData["Title"] = "Orders";
}

<h2>@(User.IsInRole("Admin") ? "Manage All Orders" : "My Order History")</h2>

<table class="table table-striped mt-3">
    <thead class="table-dark">
        <tr>
            <th>Order Number</th>
            <th>Date</th>
            <th>Total</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.OrderNumber</td>
                <td>@item.OrderDate.ToShortDateString()</td>
                <td>$@item.TotalAmount.ToString("0.00")</td>
                <td>
                    @if (item.Status == 0)
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else
                    {

                        <span class="badge bg-success">Shipped</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-info">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>