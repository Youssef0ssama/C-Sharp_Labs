@model EcommerceApp.Models.Address
@{
    ViewData["Title"] = "Add Address";
}

<h2>Add New Address</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-2"><label asp-for="Street"></label><input asp-for="Street" class="form-control" /></div>
            <div class="form-group mb-2"><label asp-for="City"></label><input asp-for="City" class="form-control" /></div>
            <div class="form-group mb-2"><label asp-for="Zip"></label><input asp-for="Zip" class="form-control" /></div>
            <div class="form-group mb-3"><label asp-for="Country"></label><input asp-for="Country" class="form-control" /></div>
            <button type="submit" class="btn btn-success">Save Address</button>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </form>
    </div>
</div>