@model EcommerceApp.Models.Address
@{
    ViewData["Title"] = "Delete Address";
}

<h2>Delete Address</h2>
<h4 class="text-danger">Are you sure you want to delete this address?</h4>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-2">Street</dt>
        <dd class="col-sm-10">@Model.Street</dd>
        
        <dt class="col-sm-2">City</dt>
        <dd class="col-sm-10">@Model.City</dd>
        
        <dt class="col-sm-2">Zip</dt>
        <dd class="col-sm-10">@Model.Zip</dd>
        
        <dt class="col-sm-2">Country</dt>
        <dd class="col-sm-10">@Model.Country</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="AddressId" />
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>