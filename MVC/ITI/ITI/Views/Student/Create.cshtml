
@model StudentVM
@{
    Layout = "_layout2";
    SelectList deptList = new SelectList(ViewBag.depts, "DeptId", "DeptName");
}

<form method="post">
    <div asp-validation-summary="All"></div>
    <label asp-for="Name"></label><input asp-for="Name" />
    <span asp-validation-for="Name">    </span>
    <br />
    <label asp-for="Age"></label><input asp-for="Age" />
    <span asp-validation-for="Age">    </span>
    <br />
    <label asp-for="Email"></label><input asp-for="Email" />
    <span asp-validation-for="Email">    </span>
    <br />
    <br />
    <label asp-for="Password"></label><input asp-for="Password" />
    <span asp-validation-for="Password">    </span>
    <br />
    <br />
    <label asp-for="CPassword">confirm password</label><input asp-for="CPassword" />
    <span asp-validation-for="CPassword">    </span>
    <br />
    <label asp-for="DeptNo">Department</label>
    <select asp-for="DeptNo" asp-items="deptList">
        <option>Select Department</option>
    </select>
    <span asp-validation-for="DeptNo">   </span>
    <br />
    <input type="submit" value="add" />
</form>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}