@model IEnumerable<Department>
@{
    // Layout = "_layout2";
    ViewBag.Title = "department";
}
<a asp-action="create" class="btn btn-danger">Create</a>
<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>DepartmentId</th>
            <th>Name</th>
            <th>Capacity</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || Model.Count() == 0)
        {
            <tr>
                <td colspan="4" class="text-center">No data found</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.DeptId</td>
                    <td>@item.DeptName</td>
                    <td>@item.Capacity</td>
                    <td>
                        <a asp-action="Edit" class="btn btn-primary">edit</a>|
                        <a asp-action="Details" class="btn btn-primary">details</a>|
                        <a asp-action="Delete" class="btn btn-primary" onclick="return confirm(" are you sure ?")">delete</a>|
                        <a asp-action="showCourses" asp-controller="department" asp-route-id="@item.DeptId" class="btn btn-danger">showcourses</a>|
                        <a asp-action="ManageDeptCourse" asp-controller="department" asp-route-id="@item.DeptId" class="btn btn-danger">updatecourse</a>|
                    </td>
                </tr>
            }
        }